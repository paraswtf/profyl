datasource db {
    provider  = "mongodb"
    // url      = env("DATABASE_URL")
    url       = env("DATABASE_URL_PRISMA")
    directUrl = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    //All from nextauth
    id            String          @id @default(auto()) @map("_id") @db.ObjectId
    name          String?
    email         String?         @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    // Optional for WebAuthn support
    Authenticator Authenticator[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    //Our Schema below this line
    organisations Organisation[]
    redirects     Redirect[]
}

model Account {
    //All from nextauth
    id                String  @id @default(auto()) @map("_id") @db.ObjectId
    userId            String  @db.ObjectId
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.String
    access_token      String? @db.String
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.String
    session_state     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    //Our Schema below this line

    @@unique([provider, providerAccountId])
}

model Session {
    //All from nextauth
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    sessionToken String   @unique
    userId       String   @db.ObjectId
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    //Our Schema below this line
}

model VerificationToken {
    //All from nextauth
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    identifier String
    token      String
    expires    DateTime
    //Our Schema below this line

    @@unique([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
    //All from nextauth
    credentialID         String  @id @map("_id")
    userId               String  @db.ObjectId
    providerAccountId    String
    credentialPublicKey  String
    counter              Int
    credentialDeviceType String
    credentialBackedUp   Boolean
    transports           String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    //Our Schema below this line

    @@unique([userId, credentialID])
}

model Redirect {
    id       String  @id @default(auto()) @map("_id") @db.ObjectId
    type     String //REDIRECT (to add proxy, etc later)
    slug     String
    //We store the passowrd in the database as a hash, we store this since we sometimes also need a raw url
    password String? //We use this to protect the URL when needed, it is decrypted using password on client side

    //The key to edit or delete the url in case of unauthenticated users
    //Not present if the user is authenticated
    updateKey String?

    //The target URL
    target String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    creatorId String? @db.ObjectId
    creator   User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)
    domainId  String
    domain    Domain  @relation(fields: [domainId], references: [id], onDelete: Cascade)

    @@unique(name: "uniqueId", [slug, domainId])
}

model Organisation {
    id      String   @id @default(auto()) @map("_id") @db.ObjectId
    name    String
    ownerId String   @db.ObjectId
    owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    domains Domain[]
    APIKeys APIKey[]
}

model Domain {
    id             String       @id @map("_id")
    organisationId String       @db.ObjectId
    organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
    redirects      Redirect[]
    isVerified     Boolean      @default(false)
}

model APIKey {
    id             String        @id @default(auto()) @map("_id") @db.ObjectId
    key            String        @unique
    organisationId String?       @db.ObjectId
    organisation   Organisation? @relation(fields: [organisationId], references: [id])
}
